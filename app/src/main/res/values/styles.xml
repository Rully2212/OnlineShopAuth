<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OnlineShopAuth" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorPrimaryDark">@color/brand_red_dark</item>
        <item name="colorAccent">@color/brand_red</item>
        <item name="android:statusBarColor">@color/brand_red_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="InputField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:background">@drawable/bg_button_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
